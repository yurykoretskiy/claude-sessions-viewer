{
  "name": "claude-sessions-viewer",
  "displayName": "Session Viewer",
  "description": "Browse Claude Code and Codex sessions together by date or project folder. Read-only, local, zero dependencies.",
  "version": "1.20.2",
  "publisher": "yurykoretskiy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "benchmark:500": "node --expose-gc scripts/benchmark-500-sessions.js",
    "standalone": "node standalone.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Browsing and reading sessions works in untrusted workspaces. Starting or resuming a session opens a visible terminal, so those actions are best used in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Reads Claude Code session files from the local disk (~/.claude), which is unavailable in virtual workspaces."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSessions",
          "title": "Session Viewer",
          "icon": "assets/mascot-prominent.png"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "id": "claudeSessions.tree",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessions.revealCurrent",
        "title": "Session Viewer: Reveal current Claude session",
        "icon": {
          "light": "assets/mascot-prominent.png",
          "dark": "assets/mascot-prominent.png"
        }
      },
      {
        "command": "claudeSessions.newHere",
        "title": "New Claude terminal session here",
        "icon": {
          "light": "assets/tree-terminal-light.svg",
          "dark": "assets/tree-terminal-dark.svg"
        }
      },
      {
        "command": "claudeSessions.newClaudeCodeHere",
        "title": "New Claude Code session here",
        "icon": {
          "light": "assets/claude-code-logo-light.svg",
          "dark": "assets/claude-code-logo-dark.svg"
        }
      },
      {
        "command": "claudeSessions.newWindowHere",
        "title": "New window session here (panel)",
        "icon": "$(empty-window)"
      },
      {
        "command": "claudeSessions.toggleGrouping",
        "title": "Claude Sessions: Switch to session timeline (now: folders A-Z)",
        "icon": "$(list-tree)"
      },
      {
        "command": "claudeSessions.toggleGroupingAlt",
        "title": "Claude Sessions: Switch to folders A-Z (now: session timeline)",
        "icon": "$(list-flat)"
      },
      {
        "command": "claudeSessions.showInFolders",
        "title": "Show in folder view"
      },
      {
        "command": "claudeSessions.resume",
        "title": "Resume in terminal",
        "icon": {
          "light": "assets/tree-terminal-light.svg",
          "dark": "assets/tree-terminal-dark.svg"
        }
      },
      {
        "command": "claudeSessions.openInClaudeCode",
        "title": "Open in Claude Code VS Code extension",
        "icon": {
          "light": "assets/claude-code-logo-light.svg",
          "dark": "assets/claude-code-logo-dark.svg"
        }
      },
      {
        "command": "claudeSessions.openConversation",
        "title": "Open in viewer",
        "icon": {
          "light": "assets/tree-open-preview-light.svg",
          "dark": "assets/tree-open-preview-dark.svg"
        }
      },
      {
        "command": "claudeSessions.refresh",
        "title": "Session Viewer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessions.expandAll",
        "title": "Claude Sessions: Expand folders",
        "icon": "$(expand-all)"
      },
      {
        "command": "claudeSessions.collapseAll",
        "title": "Claude Sessions: Collapse folders",
        "icon": "$(collapse-all)"
      },
      {
        "command": "claudeSessions.copySessionPath",
        "title": "Copy session path",
        "icon": {
          "light": "assets/tree-copy-light.svg",
          "dark": "assets/tree-copy-dark.svg"
        }
      },
      {
        "command": "claudeSessions.openSettings",
        "title": "Session Viewer: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "claudeSessions.openTabInMessenger",
        "title": "Session Viewer: Open in Messenger View"
      },
      {
        "command": "claudeSessions.openTabInPreview",
        "title": "Session Viewer: Open in Sessions Tree View"
      },
      {
        "command": "claudeSessions.openRowInMessenger",
        "title": "Session Viewer: Open in Messenger View"
      },
      {
        "command": "claudeSessions.openRowInPreview",
        "title": "Session Viewer: Open in Sessions Tree View"
      }
    ],
    "submenus": [
      {
        "id": "claudeSessions.openTargets",
        "label": "Session Viewer: Open session",
        "icon": {
          "light": "assets/mascot-prominent.png",
          "dark": "assets/mascot-prominent.png"
        }
      }
    ],
    "menus": {
      "claudeSessions.openTargets": [
        {
          "command": "claudeSessions.revealCurrent",
          "group": "navigation@1",
          "toggled": "claudeSessions.defaultOpenTarget == 'both'"
        },
        {
          "command": "claudeSessions.openTabInMessenger",
          "group": "navigation@2"
        },
        {
          "command": "claudeSessions.openTabInPreview",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "claudeSessions.newHere",
          "when": "explorerResourceIsFolder && config.claudeSessionsViewer.folderActions.terminal.enabled",
          "group": "2_workspace@99"
        },
        {
          "command": "claudeSessions.newClaudeCodeHere",
          "when": "explorerResourceIsFolder && config.claudeSessionsViewer.folderActions.claudeCode.enabled",
          "group": "2_workspace@98"
        }
      ],
      "editor/title": [
        {
          "submenu": "claudeSessions.openTargets",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel' && config.claudeSessionsViewer.reveal.enabled",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeSessions.openTabInMessenger",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel'",
          "group": "sessionViewer@1"
        },
        {
          "command": "claudeSessions.openTabInPreview",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel'",
          "group": "sessionViewer@2"
        }
      ],
      "webview/context": [
        {
          "command": "claudeSessions.openRowInMessenger",
          "when": "webviewSection == 'session'",
          "group": "sessionViewer@1"
        },
        {
          "command": "claudeSessions.openRowInPreview",
          "when": "webviewSection == 'session'",
          "group": "sessionViewer@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "Session Viewer",
        "order": 1,
        "properties": {
          "claudeSessionsViewer.reveal.enabled": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "scope": "window",
            "markdownDescription": "Show the **Reveal current session** ✳ button on the Claude Code panel tab and in the status bar."
          },
          "claudeSessionsViewer.reveal.openConversation": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "scope": "window",
            "markdownDescription": "When you reveal the current Claude session, also open its **read-only conversation** beside the editor.\n\n- On (default): reveal also opens the chat.\n- Off: reveal only selects the session in Session Viewer."
          }
        }
      },
      {
        "title": "Session Viewer",
        "order": 2,
        "properties": {
          "claudeSessionsViewer.theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "enumDescriptions": [
              "Follow the current VS Code theme",
              "Always light",
              "Always dark"
            ],
            "default": "system",
            "order": 1,
            "scope": "window",
            "markdownDescription": "Theme for the conversation viewer."
          },
          "claudeSessionsViewer.liveRefresh.enabled": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "scope": "window",
            "markdownDescription": "Keep an open conversation updating **live** while its session keeps writing. Off by default to stay light."
          },
          "claudeSessionsViewer.shortPreviewLines": {
            "type": "number",
            "default": 14,
            "minimum": 1,
            "maximum": 30,
            "order": 3,
            "scope": "window",
            "markdownDescription": "How many lines a folded Claude message shows. User prompts stay compact at 4 lines."
          },
          "claudeSessionsViewer.userLabel": {
            "type": "string",
            "default": "USER",
            "order": 4,
            "scope": "window",
            "markdownDescription": "Label used for user messages in the viewer footer and conversation copies."
          },
          "claudeSessionsViewer.agentLabel": {
            "type": "string",
            "default": "CLAUDE",
            "order": 5,
            "scope": "window",
            "markdownDescription": "Label used for assistant messages in the viewer footer and conversation copies."
          }
        }
      },
      {
        "title": "Session Viewer Sources",
        "order": 3,
        "properties": {
          "claudeSessionsViewer.showAutomationSessions": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "scope": "window",
            "markdownDescription": "Also show Claude **automation sessions** created by SDK runs and background agents. Codex subagent sidechains stay excluded."
          },
          "claudeSessionsViewer.folderActions.claudeCode.enabled": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "scope": "window",
            "markdownDescription": "Show the hover action on folder rows that starts a **new conversation in the official Claude Code VS Code extension**. It reuses the current window when that folder is already open; otherwise it opens the folder in a new window."
          },
          "claudeSessionsViewer.folderActions.terminal.enabled": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "scope": "window",
            "markdownDescription": "Show the hover action on folder rows that opens a **new terminal session** rooted in that folder and runs `claude`."
          }
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yurykoretskiy/claude-sessions-viewer.git"
  },
  "homepage": "https://github.com/yurykoretskiy/claude-sessions-viewer#readme",
  "icon": "assets/mascot-icon.png",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "session",
    "history",
    "conversation",
    "transcript",
    "viewer",
    "ai",
    "productivity"
  ],
  "galleryBanner": {
    "color": "#1a1a1b",
    "theme": "dark"
  }
}
